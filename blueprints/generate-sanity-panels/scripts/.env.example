# Names only — never commit real values.
# Collect at FIRST RUN / Definition. Pass on every script invocation:
#   VAR=value python3 scripts/<script>.py ...
#   or equivalent --flags (see scripts --help).

# Algolia (when catalogue = Algolia)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=

# Preview / gallery hosts (user supplies — no skill defaults)
NEXT_NEXT_EDEN_BASE_URL=
EDEN_BLOG_BASE_URL=

# Sanity CMS (user supplies — never hardcode project/dataset)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_PREVIEW_TOKEN=
SANITY_API_EDITOR_TOKEN=
